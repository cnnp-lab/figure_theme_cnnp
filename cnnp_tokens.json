{
  "meta": {
    "name": "CNNP figure theme — design tokens",
    "description": "Language-neutral source of truth for the CNNP figure theme. The R, MATLAB, and Python adapters each read this file and wire it into their own plotting API. Edit colours, sizes, and palettes HERE — never in a language adapter.",
    "units": "colours = hex strings; font / stroke / marker sizes = points (pt); figure widths = millimetres (mm); typographic scale = unitless ratios of base_size. Adapters whose native unit is mm (e.g. ggplot2 line widths) convert pt -> mm via 72.27/25.4.",
    "guidelines": "Human-facing usage rules live in GUIDELINES.md (single source for all languages)."
  },

  "typography": {
    "font_prefer": ["Helvetica", "Arial"],
    "base_size_pt": 8,
    "label_size_pt": 8,
    "scale": {
      "axis_text": 1.0,
      "axis_title": 1.15,
      "legend_text": 1.0,
      "legend_title": 1.15,
      "strip_text": 1.0,
      "plot_title": 1.15,
      "plot_subtitle": 1.0,
      "plot_caption": 0.9,
      "plot_tag": 1.15
    }
  },

  "geometry": {
    "axis_tick_length_pt": 2,
    "panel_gutter": 1,
    "marker_point_size_pt": 3.4143307086614175,
    "line_weights_pt": {
      "hairline": 0.4267913385826772,
      "fine":     0.5690551181102362,
      "thin":     0.7113188976377954,
      "rule":     0.8535826771653543,
      "medium":   1.1381102362204724,
      "regular":  1.4226377952755906
    }
  },

  "colors": {
    "neutral": {
      "cream":    "#fffdef",
      "midnight": "#223344",
      "bluegrey": "#66808e",
      "brown":    "#3d2307"
    },
    "pairs": {
      "teal":    { "dark": "#005d76", "light": "#9dc2cc" },
      "mustard": { "dark": "#8a6408", "light": "#d4a017" },
      "purple":  { "dark": "#6A51A3", "light": "#c9b8e8" }
    },
    "okabe_ito": {
      "orange":     "#E69F00",
      "sky_blue":   "#56B4E9",
      "green":      "#009E73",
      "yellow":     "#F0E442",
      "blue":       "#0072B2",
      "vermillion": "#D55E00",
      "pink":       "#CC79A7",
      "black":      "#111111"
    },
    "greys": {
      "faint":    "#F0F0F0",
      "light":    "#E8E8E8",
      "silver":   "#D9D9D9",
      "medium":   "#CCCCCC",
      "dark":     "#AAAAAA",
      "charcoal": "#4D4D4D"
    }
  },

  "scales": {
    "na_value": "greys.light",
    "gradient":   { "low": "white", "high": "teal.dark" },
    "sequential": { "colors": ["white", "teal.light", "teal.dark"], "values": [0, 0.374, 1] },
    "diverging":  { "low": "okabe_ito.vermillion", "mid": "white", "high": "teal.dark" }
  },

  "shapes": [
    "circle_filled",
    "triangle_filled",
    "square_filled",
    "diamond_filled",
    "plus",
    "asterisk",
    "square_cross",
    "cross"
  ],

  "export": {
    "widths_mm": { "single": 90, "onehalf": 140, "double": 190 },
    "dpi": 300
  },

  "ascii_fold": {
    "—": "-",
    "–": "-",
    "−": "-",
    "‘": "'",
    "’": "'",
    "“": "\"",
    "”": "\"",
    "…": "..."
  }
}
